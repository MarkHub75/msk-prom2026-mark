# Copy to .env. Empty LINQ_* keys: work with SAFEWATCH_FAKE=1.
SAFEWATCH_FAKE=0
LINQ_VPN_USER=
LINQ_VPN_PASSWORD=
LINQ_JUPYTER_URL=
LINQ_JUPYTER_USER=
LINQ_JUPYTER_PASSWORD=
LINQ_JUPYTER_TOKEN=
INFERENCE_BACKEND=linq
# optional: LinQ TPU broker (defaults: 127.0.0.1 via tunnel, 10.0.114.30 inside Jupyter; guest/guest)
LINQ_AMQP_HOST=
LINQ_AMQP_PORT=
# optional: ssh target of the tunnel host (default in tools/linq/tunnel/LinQ.ps1)
LINQ_TUNNEL_REMOTE=
