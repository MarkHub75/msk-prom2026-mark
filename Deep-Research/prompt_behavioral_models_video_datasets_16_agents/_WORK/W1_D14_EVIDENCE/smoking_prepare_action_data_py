import os
import csv
import cv2
import numpy as np
from huggingface_hub import hf_hub_download
from ultralytics import YOLO


REPO_ID = "Sina272/hmdb51-v2"

MODEL_PATH = "yolov8n-pose.pt"

OUTPUT_DIR = "pose_action_data"
VIDEO_DIR = "action_videos"

CLASSES = [
    "smoke",
    "sit",
    "stand",
    "walk"
]

VIDEOS_PER_CLASS = 100

SEQUENCE_LENGTH = 30

MAX_CANDIDATE_FRAMES = 120

CONFIDENCE = 0.20

IMAGE_SIZE = 640


model = YOLO(MODEL_PATH)


for class_name in CLASSES:

    os.makedirs(
        os.path.join(
            OUTPUT_DIR,
            class_name
        ),
        exist_ok=True
    )

    os.makedirs(
        os.path.join(
            VIDEO_DIR,
            class_name
        ),
        exist_ok=True
    )


print()
print("=" * 60)
print("HMDB51 POSE DATA PREPARATION")
print("=" * 60)


print()
print("Downloading metadata...")


metadata_path = hf_hub_download(
    repo_id=REPO_ID,
    filename="metadata_train.csv",
    repo_type="dataset"
)


print("Metadata loaded.")


selected = {
    name: []
    for name in CLASSES
}


with open(
    metadata_path,
    "r",
    encoding="utf-8"
) as file:

    reader = csv.DictReader(file)

    for row in reader:

        label = row.get("label")
        filename = row.get("file_name")

        if label not in CLASSES:
            continue

        if not filename:
            continue

        if len(
            selected[label]
        ) >= VIDEOS_PER_CLASS:
            continue

        selected[label].append(
            filename
        )


print()

for class_name in CLASSES:

    print(
        f"{class_name.upper():12} "
        f"{len(selected[class_name])} videos available"
    )


def get_existing_count(folder):

    files = [
        f
        for f in os.listdir(folder)
        if f.endswith(".npy")
    ]

    return len(files)


def get_video(
    relative_path,
    class_name
):

    filename = os.path.basename(
        relative_path
    )

    local_path = os.path.join(
        VIDEO_DIR,
        class_name,
        filename
    )

    if os.path.exists(local_path):

        return local_path

    print(
        f"Downloading: {filename}"
    )

    try:

        downloaded = hf_hub_download(
            repo_id=REPO_ID,
            filename=relative_path,
            repo_type="dataset"
        )

        with open(
            downloaded,
            "rb"
        ) as source:

            data = source.read()

        with open(
            local_path,
            "wb"
        ) as destination:

            destination.write(data)

        return local_path

    except Exception as error:

        print(
            f"Download failed: {error}"
        )

        return None


def get_pose(frame):

    try:

        results = model.predict(
            frame,
            imgsz=IMAGE_SIZE,
            conf=CONFIDENCE,
            iou=0.50,
            max_det=10,
            verbose=False
        )

    except Exception as error:

        print(
            f"YOLO error: {error}"
        )

        return None


    best_pose = None
    best_area = 0


    for result in results:

        if result.boxes is None:
            continue

        if result.keypoints is None:
            continue

        if len(result.boxes) == 0:
            continue


        boxes = (
            result.boxes.xyxy
            .cpu()
            .numpy()
        )

        points = (
            result.keypoints.xy
            .cpu()
            .numpy()
        )


        for i in range(
            min(
                len(boxes),
                len(points)
            )
        ):

            pose = points[i]

            if pose.shape != (17, 2):
                continue


            x1, y1, x2, y2 = boxes[i]


            width = x2 - x1
            height = y2 - y1


            if width < 10:
                continue

            if height < 10:
                continue


            area = width * height


            if area <= best_area:
                continue


            normalized = pose.copy()


            normalized[:, 0] = (
                normalized[:, 0] - x1
            ) / width


            normalized[:, 1] = (
                normalized[:, 1] - y1
            ) / height


            normalized = np.clip(
                normalized,
                0,
                1
            )


            best_pose = (
                normalized.flatten()
            )

            best_area = area


    return best_pose


def process_video(
    video_path
):

    cap = cv2.VideoCapture(
        video_path
    )


    if not cap.isOpened():

        print(
            "Could not open video."
        )

        return None


    frame_count = int(
        cap.get(
            cv2.CAP_PROP_FRAME_COUNT
        )
    )


    fps = cap.get(
        cv2.CAP_PROP_FPS
    )


    print(
        f"Frames: {frame_count} | "
        f"FPS: {fps:.2f}"
    )


    if frame_count < 5:

        cap.release()

        return None


    candidate_count = min(
        MAX_CANDIDATE_FRAMES,
        frame_count
    )


    indices = np.linspace(
        0,
        frame_count - 1,
        candidate_count
    ).astype(int)


    poses = []


    for index in indices:

        cap.set(
            cv2.CAP_PROP_POS_FRAMES,
            int(index)
        )


        success, frame = cap.read()


        if not success:
            continue


        if frame is None:
            continue


        pose = get_pose(
            frame
        )


        if pose is None:
            continue


        poses.append(
            pose
        )


        if len(poses) >= SEQUENCE_LENGTH:

            break


    cap.release()


    if len(poses) < SEQUENCE_LENGTH:

        print(
            f"Only {len(poses)} valid "
            f"pose frames found."
        )

        return None


    return np.asarray(
        poses[:SEQUENCE_LENGTH],
        dtype=np.float32
    )


total_saved = 0


for class_name in CLASSES:

    print()
    print("=" * 60)
    print(
        f"PROCESSING: {class_name.upper()}"
    )
    print("=" * 60)


    output_folder = os.path.join(
        OUTPUT_DIR,
        class_name
    )


    existing_count = get_existing_count(
        output_folder
    )


    print(
        f"Existing sequences: "
        f"{existing_count}"
    )


    if existing_count >= VIDEOS_PER_CLASS:

        print(
            "Target already reached. "
            "Skipping class."
        )

        continue


    start_index = existing_count


    videos = selected[
        class_name
    ]


    for index in range(
        start_index,
        len(videos)
    ):

        print()
        print(
            f"[{index + 1}/{len(videos)}]"
        )


        relative_path = videos[
            index
        ]


        video_path = get_video(
            relative_path,
            class_name
        )


        if video_path is None:
            continue


        print(
            "Extracting pose sequence..."
        )


        sequence = process_video(
            video_path
        )


        if sequence is None:

            print(
                "SKIPPED - no valid sequence"
            )

            continue


        output_file = os.path.join(
            output_folder,
            f"{existing_count:05d}.npy"
        )


        np.save(
            output_file,
            sequence
        )


        print(
            f"SAVED: {output_file}"
        )


        existing_count += 1
        total_saved += 1


        if existing_count >= VIDEOS_PER_CLASS:

            break


print()
print("=" * 60)
print("DATA PREPARATION FINISHED")
print("=" * 60)


total_sequences = 0


for class_name in CLASSES:

    folder = os.path.join(
        OUTPUT_DIR,
        class_name
    )


    count = len([
        f
        for f in os.listdir(folder)
        if f.endswith(".npy")
    ])


    total_sequences += count


    print(
        f"{class_name.upper():12} "
        f"{count} sequences"
    )


print()
print(
    f"TOTAL: {total_sequences}"
)

print()
print(
    "Target: up to 100 sequences per class."
)